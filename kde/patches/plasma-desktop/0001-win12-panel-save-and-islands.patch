index 0000000..51e6ea4
--- /dev/null
+++ b/containments/panel/autotests/win12layoutmanagertest.cpp
@@ -0,0 +1,36 @@
+// Win12: indexAtCoordinates never returns past appletsModel.count.  SPDX-License-Identifier: LGPL-2.0-or-later
+#include <QFile>
+#include <QJSEngine>
+#include <QTest>
+
+class Win12LayoutManagerTest : public QObject
+{
+    Q_OBJECT
+private Q_SLOTS:
+    void indexAtCoordinates()
+    {
+        QFile f(QStringLiteral(LAYOUTMANAGER_JS));
+        QVERIFY(f.open(QIODevice::ReadOnly));
+        QJSEngine e;
+        QJSValue r = e.evaluate(QString::fromUtf8(f.readAll()), f.fileName());
+        QVERIFY2(!r.isError(), qPrintable(r.toString()));
+        // horizontal panel: 7 widgets 40 px wide from x = 0, then lastSpacer (index aliased to the count) to 400
+        r = e.evaluate(QStringLiteral(R"(
+            root = {isHorizontal: true, plasmoid: {formFactor: 2}};
+            appletsModel = {count: 7};
+            layout = {height: 40, rowSpacing: 50, childAt: function (x, y) {
+                if (x < 0 || x >= 400) return null;
+                return x < 280 ? {index: Math.floor(x / 40), x: Math.floor(x / 40) * 40, width: 40} : {index: 7, x: 280, width: 120};
+            }};
+            const a = [10, 30, 300, 390, 450].map(x => indexAtCoordinates(x, 0));
+            layout.childAt = function () { return null; };   // nothing hit: the scan runs past x = 0
+            a.concat(indexAtCoordinates(100, 0)).join();
+        )"));
+        QVERIFY2(!r.isError(), qPrintable(r.toString()));
+        // right half of lastSpacer (and past it) is the end, not count + 1; no hit at all is the start
+        QCOMPARE(r.toString(), QStringLiteral("0,1,7,7,7,0"));
+    }
+};
+
+QTEST_GUILESS_MAIN(Win12LayoutManagerTest)
+#include "win12layoutmanagertest.moc"
