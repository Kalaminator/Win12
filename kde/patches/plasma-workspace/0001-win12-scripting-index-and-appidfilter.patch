@@ -0,0 +1,81 @@
+/*
+    Win12: TasksModel::appIdFilter include/exclude modes (launcher rows carry an AppId, no window system needed).
+    SPDX-License-Identifier: LGPL-2.1-or-later
+*/
+#include <QSignalSpy>
+#include <QTest>
+
+#include "abstracttasksmodel.h"
+#include "tasksmodel.h"
+
+using namespace TaskManager;
+
+class Win12AppIdFilterTest : public QObject
+{
+    Q_OBJECT
+    QStringList m_urls;
+    static QString appId(TasksModel &m, int row)
+    {
+        return m.data(m.index(row, 0), AbstractTasksModel::AppId).toString();
+    }
+    // Not used by QML, so componentComplete() fills the model at once (else a 0 ms timer does it).
+    bool setup(TasksModel &m)
+    {
+        m.componentComplete();
+        m.setLauncherList(m_urls);
+        return m.rowCount() == 2;
+    }
+
+private Q_SLOTS:
+    void initTestCase()
+    {
+        qputenv("XDG_DATA_DIRS", QFINDTESTDATA("data").toLocal8Bit());
+        m_urls = {QUrl::fromLocalFile(QFINDTESTDATA("data/applications/org.kde.dolphin.desktop")).toString(),
+                  QUrl::fromLocalFile(QFINDTESTDATA("data/applications/org.kde.konversation.desktop")).toString()};
+    }
+    void noFilterShowsAll()
+    {
+        TasksModel m;
+        QVERIFY(setup(m));
+        m.setAppIdFilterExclude(true); // exclude nothing = everything
+        QCOMPARE(m.rowCount(), 2);
+    }
+    void includeMode()
+    {
+        TasksModel m;
+        QVERIFY(setup(m));
+        const QString dolphin = appId(m, 0);
+        QVERIFY(!dolphin.isEmpty());
+        QSignalSpy spy(&m, &TasksModel::appIdFilterChanged);
+        m.setAppIdFilter({dolphin});
+        QCOMPARE(spy.count(), 1);
+        QCOMPARE(m.rowCount(), 1);
+        QCOMPARE(appId(m, 0), dolphin);
+        m.setAppIdFilter({QStringLiteral("nothing.desktop")});
+        QCOMPARE(m.rowCount(), 0);
+        m.setAppIdFilter({});
+        QCOMPARE(m.rowCount(), 2);
+    }
+    void excludeMode()
+    {
+        TasksModel m;
+        QVERIFY(setup(m));
+        const QString dolphin = appId(m, 0);
+        m.setAppIdFilterExclude(true);
+        m.setAppIdFilter({dolphin});
+        QCOMPARE(m.rowCount(), 1);
+        QVERIFY(appId(m, 0) != dolphin);
+    }
+    void launcherUrlFallback()
+    {
+        TasksModel m;
+        QVERIFY(setup(m));
+        const QString url = m.data(m.index(0, 0), AbstractTasksModel::LauncherUrlWithoutIcon).toUrl().toString();
+        QVERIFY(!url.isEmpty());
+        m.setAppIdFilter({url});
+        QCOMPARE(m.rowCount(), 1);
+    }
+};
+
+QTEST_MAIN(Win12AppIdFilterTest)
+#include "win12appidfiltertest.moc"
