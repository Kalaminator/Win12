+    }
+    // the width the panel gets, animated: the grid shows its right end while it grows or shrinks (win12Scroll)
+    property real win12Width: mainLayout.implicitWidth - win12Cut
+    Behavior on win12Width {
+        enabled: root.win12Inline
+        NumberAnimation { duration: Kirigami.Units.longDuration; easing.type: Easing.OutCubic }
+    }
