+/*
+    SPDX-FileCopyrightText: 2026 Win12
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+// Win12 readable glass: the blur colour matrix (src/plugins/blur/colormatrix.h). Header only, no libkwin.
+#include "../src/plugins/blur/colormatrix.h"
+
+#include <QTest>
+#include <QVector4D>
+
+#include <cmath>
+
+using KWin::win12ColorTransformMatrix;
+
+class Win12BlurColorMatrixTest : public QObject
+{
+    Q_OBJECT
+private Q_SLOTS:
+    void identityByDefault();
+    void saturationKeepsGreysAndLuminance();
+    void squeezeDark();
+    void squeezeLight();
+};
+
+// onscreen.frag does `colour * colorMatrix`: a row vector times the matrix, alpha 1.
+static QVector4D apply(const QMatrix4x4 &m, float r, float g, float b)
+{
+    return QVector4D(r, g, b, 1) * m;
+}
+
+static bool near(float a, float b)
+{
+    return std::abs(a - b) < 1e-4;
+}
+
+static float luminance(const QVector4D &c)
+{
+    return 0.2126 * c.x() + 0.7152 * c.y() + 0.0722 * c.z();
+}
+
+static const QList<QVector4D> s_colours{{0, 0, 0, 1}, {1, 1, 1, 1}, {.5, .5, .5, 1}, {1, 0, 0, 1}, {.2, .6, .9, 1}};
+
+void Win12BlurColorMatrixTest::identityByDefault()
+{
+    // contrast 1 = upstream with no squeeze; the kcfg defaults 100/50 after /100 are the same call.
+    for (const QMatrix4x4 &m : {win12ColorTransformMatrix(1.0, 1.0, 0.5), win12ColorTransformMatrix(1.0, 100 / 100.0, 50 / 100.0)}) {
+        QVERIFY(m.isIdentity());
+        for (const QVector4D &c : s_colours) {
+            const QVector4D o = apply(m, c.x(), c.y(), c.z());
+            QVERIFY(near(o.x(), c.x()) && near(o.y(), c.y()) && near(o.z(), c.z()) && near(o.w(), 1));
+        }
+    }
+}
+
+void Win12BlurColorMatrixTest::saturationKeepsGreysAndLuminance()
+{
+    const QMatrix4x4 m = win12ColorTransformMatrix(1.5, 1.0, 0.5); // kwin's default Saturation 150
+    for (float v : {0.f, .3f, .5f, 1.f}) {
+        const QVector4D o = apply(m, v, v, v);
+        QVERIFY(near(o.x(), v) && near(o.y(), v) && near(o.z(), v));
+    }
+    const QVector4D o = apply(m, .2, .6, .9);
+    QVERIFY(near(luminance(o), luminance(QVector4D(.2, .6, .9, 1))));
+    QVERIFY(!near(o.x(), .2)); // it did change the colour
+}
+
+void Win12BlurColorMatrixTest::squeezeDark()
+{
+    // Win12Contrast=30, Win12Target=20 (a dark or accent bar)
+    const QMatrix4x4 m = win12ColorTransformMatrix(1.0, .3, .2);
+    QVERIFY(near(apply(m, 1, 1, 1).x(), .44) && near(apply(m, 1, 1, 1).z(), .44));
+    QVERIFY(near(apply(m, 0, 0, 0).y(), .14));
+}
+
+void Win12BlurColorMatrixTest::squeezeLight()
+{
+    // Win12Contrast=30, Win12Target=85 (a light bar)
+    const QMatrix4x4 m = win12ColorTransformMatrix(1.0, .3, .85);
+    QVERIFY(near(apply(m, 1, 1, 1).y(), .895));
+    QVERIFY(near(apply(m, 0, 0, 0).x(), .595) && near(apply(m, 0, 0, 0).w(), 1));
+}
+
+QTEST_GUILESS_MAIN(Win12BlurColorMatrixTest)
+#include "win12_blur_colormatrix_test.moc"
